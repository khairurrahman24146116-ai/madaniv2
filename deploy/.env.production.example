APP_NAME="Madani Al-Aziziyah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://PUBLIC_IP_VPS_OR_DOMAIN

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=madani_al_aziziyah
DB_USERNAME=madani
DB_PASSWORD=GANTI_DENGAN_PASSWORD_AMAN
DB_ROOT_PASSWORD=GANTI_DENGAN_ROOT_PASSWORD_AMAN

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@madani-al-aziziyah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Password sekali pakai untuk akun yang dibuat ProductionSeeder
# SEED_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
# SEED_BENDAHARA_PASSWORD=GANTI_PASSWORD_BENDAHARA